generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String  @id @default(uuid())
  username          String
  usernameCanonical String  @unique
  email             String  @unique
  phone             String
  fullName          String
  password          String
  pfpUrl            String?
  age               Int
  description       String?
  role              Role
  goal              Goal

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile  ClientProfile?
  trainerProfile TrainerProfile?

  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")

  refreshTokens RefreshToken[]

  lastUsernameChangeAt DateTime?
}

model Notification {
  id String @id @default(uuid())

  type NotificationType

  actions NotificationActions[]

  archived Boolean @default(false)

  fromUserId String?
  fromUser   User?   @relation("NotificationSender", fields: [fromUserId], references: [id])

  toUserId String
  toUser   User   @relation("NotificationReceiver", fields: [toUserId], references: [id])

  inviteId String?
  invite   Invite? @relation(fields: [inviteId], references: [id])

  createdAt DateTime @default(now())

  @@index([toUserId])
}

enum NotificationType {
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_DECLINED
  PROGRAM_ASSIGNED
}

enum NotificationActions {
  ACCEPT
  DECLINE
  ARCHIVE
  SEE_PROFILE
}

model Invite {
  id String @id @default(uuid())

  fromUserId String
  toUserId   String

  status InviteStatus @default(PENDING)

  notifications Notification[]

  expiresAt DateTime?
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model ClientProfile {
  id         String @id @default(uuid())
  bodyWeight Int
  height     Int

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  workoutsHistory Workout[]

  currentProgram    TrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  trainingProgramId String?

  assignedTrainerProfile   TrainerProfile? @relation(fields: [assignedTrainerProfileId], references: [id])
  assignedTrainerProfileId String?

  assignedAt DateTime?
}

model TrainingProgram {
  id    String @id @default(uuid())
  name  String
  cycle Cycle  @default(WEEK)

  startDate DateTime
  endDate   DateTime

  weeks          ProgramWeek[]
  targets        Target[]
  clientProfiles ClientProfile[]

  trainerAuthor   TrainerProfile @relation(fields: [trainerAuthorId], references: [id])
  trainerAuthorId String
}

model ProgramWeek {
  id       String    @id @default(uuid())
  workouts Workout[]

  trainingProgram   TrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  trainingProgramId String?
}

model Workout {
  id String @id @default(uuid())

  name String?
  day  WorkoutDay

  exercises    Exercise[]
  doneByUser   ClientProfile? @relation(fields: [doneByUserId], references: [id])
  doneByUserId String?

  programWeek   ProgramWeek? @relation(fields: [programWeekId], references: [id])
  programWeekId String?
}

model Exercise {
  id String @id @default(uuid())

  name String
  unit String

  sets    ExerciseSet[]
  targets Target[]

  workout   Workout? @relation(fields: [workoutId], references: [id])
  workoutId String?
}

model ExerciseSet {
  id String @id @default(uuid())

  reps        Int
  targetValue Float

  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  exerciseId String?
}

model Target {
  id String @id @default(uuid())

  name String

  initialValue Float
  targetValue  Float

  unit String

  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  exerciseId String?

  trainingProgram   TrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  trainingProgramId String?
}

model TrainerProfile {
  id         String @id @default(uuid())
  experience Int

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  clients  ClientProfile[]
  programs TrainingProgram[]
}

enum Cycle {
  WEEK
  TWO_WEEKS
  THREE_WEEKS
  FOUR_WEEKS
}

enum WorkoutDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Role {
  CLIENT
  TRAINER
}

enum Goal {
  STRENGTH
  MUSCLES
  FATLOSS
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  role      Role
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}
