generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  phone       String
  fullName    String
  password    String
  pfpUrl      String?
  age         Int
  description String?
  role        Role
  goal        Goal

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile  ClientProfile?
  trainerProfile TrainerProfile?

  notifications Notification[]

  refreshTokens RefreshToken[]
}

model Notification {
  id String @id @default(uuid())

  type NotificationType

  data Json?

  archived Boolean

  fromUserId String?

  toUser   User   @relation(fields: [toUserId], references: [id])
  toUserId String

  inviteId String?
  invite   Invite? @relation(fields: [inviteId], references: [id])

  createdAt DateTime @default(now())

  @@index([toUserId])
}

enum NotificationType {
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_DENIED
  PROGRAM_ASSIGNED
}

model Invite {
  id String @id @default(uuid())

  fromUserId String
  toUserId   String

  status InviteStatus

  notifications Notification[]
}

enum InviteStatus {
  ACCEPTED
  DECLINED
}

model ClientProfile {
  id         String @id @default(uuid())
  bodyWeight Int
  height     Int

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  workoutsHistory Workout[]

  currentProgram    TrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  trainingProgramId String?

  assignedTrainerProfile   TrainerProfile? @relation(fields: [assignedTrainerProfileId], references: [id])
  assignedTrainerProfileId String?

  assignedAt DateTime?
}

model TrainingProgram {
  id    String @id @default(uuid())
  cycle Cycle  @default(WEEK)

  workouts       Workout[]
  targets        Target[]
  clientProfiles ClientProfile[]
}

model Workout {
  id String @id @default(uuid())

  name String?
  day  WorkoutDay

  exercises Exercise[]

  trainingProgram   TrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  trainingProgramId String?

  doneByUser   ClientProfile? @relation(fields: [doneByUserId], references: [id])
  doneByUserId String?
}

model Exercise {
  id String @id @default(uuid())

  name String
  unit String

  sets ExerciseSet[]

  workout   Workout? @relation(fields: [workoutId], references: [id])
  workoutId String?

  targets Target[]
}

model ExerciseSet {
  id String @id @default(uuid())

  reps        Int
  targetValue Float

  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  exerciseId String?
}

model Target {
  id String @id @default(uuid())

  metric String

  initialValue Float
  targetValue  Float

  unit String

  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  exerciseId String?

  trainingProgram   TrainingProgram? @relation(fields: [trainingProgramId], references: [id])
  trainingProgramId String?
}

model TrainerProfile {
  id         String @id @default(uuid())
  experience Int

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  clients ClientProfile[]
}

enum Cycle {
  WEEK
  TWO_WEEKS
  THREE_WEEKS
  FOUR_WEEKS
}

enum WorkoutDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Role {
  CLIENT
  TRAINER
}

enum Goal {
  STRENGTH
  MUSCLES
  FATLOSS
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  role      Role
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}
